5. Booking flow (після авторизації)" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="150" width="300" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>